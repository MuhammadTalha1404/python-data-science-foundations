   "source": [
    "features = [\n",
    "    'radius', 'texture', 'perimeter', 'area', 'smoothness',\n",
    "    'compactness', 'concavity', 'concave_points', 'symmetry', 'fractal_dimension'\n",
    "]\n",
    "\n",
    "columns = ['id', 'diagnosis']\n",
    "columns += [f'{feature}_mean' for feature in features]\n",
    "columns += [f'{feature}_se' for feature in features]\n",
    "columns += [f'{feature}_worst' for feature in features]\n",
    "\n",
    "# Raw file has no header, so we add the documented column names.\n",
    "df = pd.read_csv('wdbc.data.txt', header=None, names=columns)\n",
    "\n",
    "# Save a prepared CSV for future use.\n",
    "df.to_csv('wdbc_prepared.csv', index=False)\n",
    "\n",
    "print('Prepared dataset saved as wdbc_prepared.csv')\n",
    "print('Shape:', df.shape)\n",
    "display(df.head())"
   ]
